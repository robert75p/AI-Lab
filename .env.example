# DB2 reconciliation credentials
# Copy this file to .env, fill in real values, and source it before running recon.
# Never commit .env — it is listed in .gitignore.

# Source DB2 credentials
DB2_SRC_USER=
DB2_SRC_PASSWORD=

# Target DB2 credentials
DB2_TGT_USER=
DB2_TGT_PASSWORD=

# Absolute path to the DB2 JDBC driver jar (same one DBArtisan / SQuirreL uses)
# Example: DB2_DRIVER_JAR=/opt/db2/db2jcc4.jar
# Update driver.jar in scripts/db_recon/db2_recon_config.yaml to match this path.
DB2_DRIVER_JAR=
